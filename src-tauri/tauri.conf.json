{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PyForge",
  "version": "0.1.2",
  "identifier": "ai.pyforge.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PyForge",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:* pyforge-plugin: http://pyforge-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 PyForge contributors",
    "license": "Apache-2.0",
    "shortDescription": "A Python IDE that reads syntax, not types",
    "longDescription": "PyForge is an open-source Python IDE.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "pyforge",
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: 532220677CF20C14\nRWQUDPJ8ZyAiU870AuHx7VkuBNZEHohm/6uVNXVkrvvHSe0Ettnzx08E\n",
      "endpoints": ["https://github.com/ppk159/pyforge/releases/latest/download/latest.json"]
    }
  }
}
