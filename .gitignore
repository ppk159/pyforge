# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Plugin components are checked in (plugins/build.sh --check keeps them current).
!plugins/official/*/dist
!crates/ide-plugin/tests/fixtures/*/dist
*.local

# Editor directories and files
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust
target/
# Tauri generated schemas
/src-tauri/gen/schemas
*.tsbuildinfo
test-results/
playwright-report/

# Local AI agent files. Shared skills live in .agents/skills; .claude/skills links to them.
CLAUDE.local.md
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/verify
!.claude/skills/issue-fix

# Local reference screenshots
pycharm-screenshots/

# Scratch fixture files used while driving the app by hand; never committed.
# Refactoring probes: throwaway files the measurements write into the fixture app.
fixtures/**/_*probe.py
fixtures/**/_iv*.py
fixtures/**/_im*.py
fixtures/**/_er*.py
fixtures/**/_pr*.py
fixtures/**/_cf*.py
fixtures/**/_va*.py
fixtures/**/_cv*.py
fixtures/**/_fs*.py
fixtures/**/_tv*.py
fixtures/**/_rv*.py

# Agent/skill definitions, upstream CI and per-user IDE state: kept on disk (the
# upstream tree has them, so a diff against it stays readable) but not published
# from this repo.
#
# `.github/workflows/release.yml` is this fork's own and is tracked: it is the only
# reason `.github` appears in the repo at all.
/.agents/
/.claude/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml
/.openidea/
